# ==========================================
# OBSYN LUXURY APPAREL - ENVIRONMENT CONFIG
# ==========================================

# Clerk Authentication (Configured for Google OAuth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Supabase (PostgreSQL & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Admin Access Control (Standing allowlist for site owners)
# Comma-separated list of Google accounts granted admin rights
ADMIN_EMAILS=owner@gmail.com,admin@obsyn.com

# Payment Gateway Configuration
# Supported providers: test | stripe | razorpay | paypal
PAYMENT_PROVIDER=test
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Public App URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
